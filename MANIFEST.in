include LICENSE THIRD_PARTY_NOTICES.md README.md VALIDATION.md requirements-tested.txt run.sh .env.example
recursive-include configs *.json
prune configs/local
exclude configs/synthetic.json
recursive-include docs *.md
recursive-include tools *.py *.md
recursive-include tests *.py
prune models
prune runs
prune artifacts
prune synthetic
prune scenes
prune third_party
prune .cache
global-exclude *.py[cod]
